BRAND_NAME=Mi Gestor
BRAND_COMPANY=Mi Empresa
CONTACT_EMAIL=
APP_URL=http://127.0.0.1:5001

# Vacío = la app vive en /. Para montarla bajo un prefijo: /crm
CRM_MOUNT_PATH=

# Cadena larga y aleatoria. No uses esta de ejemplo en un servidor.
SECRET_KEY=cambia-esta-clave-por-una-larga

# MySQL opcional. Si DB_HOST queda vacío se usa SQLite (data.sqlite).
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=mysql+pymysql

# IA opcional (borradores, imágenes, estudio creativo)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ruta opcional a otra app (equipo de login, portafolio I+D, correo)
# EXTRA_APP_ROOT=
# PIXELWALL_APP_DIR=
